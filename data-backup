-- ── Post Proximity Guard ─────────────────────────────────────────────────────
local GOAL_POST_DATA          = {}
local POST_GUARD_DISTANCE     = 18.0
local POST_GUARD_OFFSET_BONUS = 0
local postGuardEnabled        = true

local function buildGoalPostData()
    GOAL_POST_DATA = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "GoalPost" and obj:IsA("BasePart") then
            local cx = obj.Position.X
            local cz = obj.Position.Z
            local hw = obj.Size.X / 2
            table.insert(GOAL_POST_DATA, {
                leftX   = cx - hw,
                rightX  = cx + hw,
                centerZ = cz,
            })
        end
    end
end
buildGoalPostData()

workspace.DescendantAdded:Connect(function(obj)
    if obj.Name == "GoalPost" and obj:IsA("BasePart") then
        buildGoalPostData()
    end
end)

local function getNearestGoalPostData()
    local char = Players.LocalPlayer and Players.LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or #GOAL_POST_DATA == 0 then return nil end
    local pz = hrp.Position.Z
    local best, bestDist = nil, math.huge
    for _, gp in ipairs(GOAL_POST_DATA) do
        local d = math.abs(pz - gp.centerZ)
        if d < bestDist then bestDist = d; best = gp end
    end
    return best
end

local function getPostGuardOverride(zoneName, hasIframes)
    if not postGuardEnabled then return zoneName, false end
    local char = Players.LocalPlayer and Players.LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return zoneName, false end

    local row, col = splitZone(zoneName)
    if not row then return zoneName, false end

    local gp = getNearestGoalPostData()
    if not gp then return zoneName, false end

    local playerX     = hrp.Position.X
    local distToLeft  = math.abs(playerX - gp.leftX)
    local distToRight = math.abs(playerX - gp.rightX)

    -- Too close to LEFT post and diving LEFT → redirect to middle
    if distToLeft <= POST_GUARD_DISTANCE and (col == "LEFT" or col == "MID_LEFT") then
        return row .. "_MIDDLE", true
    end

    -- Too close to RIGHT post and diving RIGHT → redirect to middle
    if distToRight <= POST_GUARD_DISTANCE and (col == "RIGHT" or col == "MID_RIGHT") then
        return row .. "_MIDDLE", true
    end

    return zoneName, false
end
