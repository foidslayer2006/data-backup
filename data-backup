local function activateAcroKey()
    if not acroModeFromKey then
        previousAutodiveStateAcro = autodiveEnabled
        if not autodiveEnabled then setAutodiveEnabled(true) end
        acroModeFromKey = true
        updateAcroMode()
    end
end

local function deactivateAcroKey()
    if acroModeFromKey then
        acroModeFromKey = false
        updateAcroMode()
        setAutodiveEnabled(previousAutodiveStateAcro)
    end
end

