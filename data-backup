local function resetTracking(reason, keepLabels)
    tracking         = false
    currentBallModel = nil
    missedFrames     = 0
    StatusLabel:SetText(reason)
    sharedZones:hideAll()
    clearPathVisuals()
    if not keepLabels then
        PredictedLabel:SetText("Predicted: --")
        ActualLabel:SetText("Actual: --")
        DiffLabel:SetText("Difference: --")
        ZoneLabel:SetText("Zone: --")
    end
end

local function activateM2Key()
    if not m2OnlyModeFromKey then
        previousAutodiveState = autodiveEnabled
        if not autodiveEnabled then
            setAutodiveEnabled(true)
        end
        m2OnlyModeFromKey = true
        updateM2OnlyMode()
    end
end

local function deactivateM2Key()
    if m2OnlyModeFromKey then
        m2OnlyModeFromKey = false
        updateM2OnlyMode()
        setAutodiveEnabled(previousAutodiveState)
    end
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    local key        = inp.KeyCode
    local actKey     = getPickerKeyCode('AutodiveKey',    'U')
    local switchKey  = getPickerKeyCode('SwitchModeKey',  'P')
    local zonesKey   = getPickerKeyCode('ToggleZonesKey', 'H')
    local m2OnlyKey  = getPickerKeyCode('M2OnlyKey',      'F')
    local acroKey    = getPickerKeyCode('AcroModeKey',    'T')

    if key == switchKey then
        autodiveMode = (autodiveMode == "Hold") and "Toggle" or "Hold"
        ModeDisplayLabel:SetText('Current Mode: ' .. autodiveMode)
        if autodiveMode == "Hold" then
            if autodiveEnabled and not m2OnlyModeFromKey then
                setAutodiveEnabled(false)
            end
            if m2OnlyModeFromKey then deactivateM2Key() end
            if acroModeFromKey   then deactivateAcroKey() end
        end

    elseif key == actKey then
        if autodiveMode == "Toggle" then
            setAutodiveEnabled(not autodiveEnabled)
        else
            setAutodiveEnabled(true)
        end

    elseif key == m2OnlyKey then
        if autodiveMode == "Toggle" then
            if m2OnlyModeFromKey then deactivateM2Key() else activateM2Key() end
        else
            activateM2Key()
        end

    elseif key == acroKey then
        if autodiveMode == "Toggle" then
            if acroModeFromKey then deactivateAcroKey() else activateAcroKey() end
        else
            activateAcroKey()
        end
    end
end)

UserInputService.InputEnded:Connect(function(inp, gp)
    if gp then return end
    local key       = inp.KeyCode
    local actKey    = getPickerKeyCode('AutodiveKey',   'U')
    local m2OnlyKey = getPickerKeyCode('M2OnlyKey',     'F')
    local acroKey   = getPickerKeyCode('AcroModeKey',   'T')

    if key == actKey and autodiveMode == "Hold" then
        setAutodiveEnabled(false)
