local m2OnlyModeCheckbox  = false
local m2OnlyModeFromKey   = false
local autodiveMode        = "Hold"
local previousAutodiveState = false
local M2StatusLabel       = nil

local function updateM2OnlyMode()
    m2OnlyMode = m2OnlyModeCheckbox or m2OnlyModeFromKey
    if M2StatusLabel then
        if m2OnlyModeCheckbox then
            M2StatusLabel:SetText("M2 Mode: ON (Permanent)")
        elseif m2OnlyModeFromKey then
            if autodiveMode == "Toggle" then
                M2StatusLabel:SetText("M2 Mode: ON (Toggled)")
            else
                M2StatusLabel:SetText("M2 Mode: ON (Hold)")
            end
        else
            M2StatusLabel:SetText("M2 Mode: OFF")
        end
    end
end

local function getEffectiveTopThreshold(col, hasIframes)
    if acroMode then
        return ACRO_TOP_THRESHOLD
    end
    if col == "MIDDLE" then
        if hasIframes then
            return MID_IFRAME_TOP_THRESHOLD
        else
            return MID_TOP_THRESHOLD
        end
    end
    return modeB_active and MODE_B_TOP_THRESHOLD or MODE_A_TOP_THRESHOLD
end

local function getDiveOffset(zoneName, hasIframes)
    local row, col = splitZone(zoneName)
    if modeB_active then
        if col == "MID_LEFT" or col == "MID_RIGHT" then
            return row == "TOP" and modeBTopMidOffset or modeBBotMidOffset
        elseif col == "MIDDLE" then
            return modeBMidOffset
        else
            return modeBBaseOffset
        end
    else
        if col == "MID_LEFT" or col == "MID_RIGHT" then
            return row == "TOP" and topMidSideOffset or midSideOffset
        elseif col == "MIDDLE" then
            if hasIframes then
                return row == "TOP" and midOffsetIframesTop or midOffsetIframesBot
            else
                return row == "TOP" and midOffsetTop or midOffsetBot
            end
        else
            return baseOffset
        end
    end
end

