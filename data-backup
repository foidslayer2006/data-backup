local ZONE_NAMES = {
    "TOP_LEFT","TOP_MID_LEFT","TOP_MIDDLE","TOP_MID_RIGHT","TOP_RIGHT",
    "BOTTOM_LEFT","BOTTOM_MID_LEFT","BOTTOM_MIDDLE","BOTTOM_MID_RIGHT","BOTTOM_RIGHT",
}
local ZONE_COLOR_INACTIVE = Color3.fromRGB(0,  180, 255)
local ZONE_COLOR_ACTIVE   = Color3.fromRGB(255,  60,  60)
local ZONE_ALPHA_INACTIVE = 0.92
local ZONE_ALPHA_ACTIVE   = 0.30

local function splitZone(name)
    local r, c = name:match("^(TOP)_(.+)$")
    if not r then r, c = name:match("^(BOTTOM)_(.+)$") end
    return r, c
end

local function getZoneName(worldHit, gcf, gs, mf, msf, heightThreshold)
    heightThreshold = heightThreshold or 0
    local lh    = gcf:PointToObjectSpace(worldHit)
    local midW  = gs.X * mf
    local hm    = midW / 2
    local sideW = (gs.X - midW) / 2
    local msW   = sideW * msf
    local b1, b2, b3, b4 = -(hm+msW), -hm, hm, hm+msW
    local col
    if     lh.X < b1 then col = "LEFT"
    elseif lh.X < b2 then col = "MID_LEFT"
    elseif lh.X < b3 then col = "MIDDLE"
    elseif lh.X < b4 then col = "MID_RIGHT"
    else                   col = "RIGHT"
    end
    return (lh.Y >= heightThreshold and "TOP" or "BOTTOM") .. "_" .. col
end

local GoalZones = {}
GoalZones.__index = GoalZones

local function createZoneParts(gs, mf, msf, visible, heightThreshold)
    local zones   = {}
    local midW    = gs.X * mf
    local hm      = midW / 2
    local sideW   = (gs.X - midW) / 2
    local msW     = sideW * msf
    local outerW  = sideW - msW
    local colData = {
        LEFT      = { offset = -(hm + msW + outerW/2), width = outerW },
        MID_LEFT  = { offset = -(hm + msW/2),           width = msW   },
        MIDDLE    = { offset = 0,                        width = midW  },
        MID_RIGHT = { offset =  hm + msW/2,             width = msW   },
        RIGHT     = { offset =  hm + msW + outerW/2,    width = outerW },
    }
    local ht    = math.clamp(heightThreshold or 0, -(gs.Y/2 - 1), gs.Y/2 - 1)
    local topH  = gs.Y/2 - ht
    local botH  = gs.Y/2 + ht
    local rowData = {
        TOP    = { offset = ht + topH/2, height = topH },
        BOTTOM = { offset = ht - botH/2, height = botH },
    }

    for _, zn in ipairs(ZONE_NAMES) do
        local row, col = splitZone(zn)
        local cd, rd   = colData[col], rowData[row]
        local p = Instance.new("Part")
        p.Anchored    = true
        p.CanCollide  = false
        p.CastShadow  = false
        p.Material    = Enum.Material.Neon
        p.Color       = ZONE_COLOR_INACTIVE
        p.Size        = Vector3.new(cd.width - 0.4, rd.height - 0.4, 0.1)
        p:SetAttribute("LocalOffsetX", cd.offset)
        p:SetAttribute("LocalOffsetY", rd.offset)
        p.Transparency = visible and ZONE_ALPHA_INACTIVE or 1
        p.Parent       = Workspace
        zones[zn]      = p
    end
    return zones
end

function GoalZones.new(gs, opts)
    opts = opts or {}
    local self = setmetatable({}, GoalZones)
    self.gs              = gs
    self.visible         = (opts.visible == nil) and true or opts.visible
    self.mf              = opts.mf  or 0.2
    self.msf             = opts.msf or 0.28
    self.heightThreshold = opts.heightThreshold or 1.6
    self._active         = nil
    self.zones           = createZoneParts(gs, self.mf, self.msf, self.visible, self.heightThreshold)
    return self
end

function GoalZones:rebuild()
    local av = self._active
    for _, p in pairs(self.zones) do
        if p and p.Parent then p:Destroy() end
    end
    self.zones = createZoneParts(self.gs, self.mf, self.msf, self.visible, self.heightThreshold)
    if av then self:showFullZone(av) end
end

function GoalZones:setMF(v)
    self.mf = math.clamp(v, 0.05, 0.90)
    self:rebuild()
end

function GoalZones:setMSF(v)
    self.msf = math.clamp(v, 0.05, 0.95)
    self:rebuild()
end

function GoalZones:setHeightThreshold(v)
    self.heightThreshold = v
    self:rebuild()
end

function GoalZones:showFullZone(zn)
    self._active = zn
    for name, p in pairs(self.zones) do
        if name == zn then
            p.Color        = ZONE_COLOR_ACTIVE
            p.Transparency = self.visible and ZONE_ALPHA_ACTIVE or 1
        else
            p.Color        = ZONE_COLOR_INACTIVE
            p.Transparency = self.visible and ZONE_ALPHA_INACTIVE or 1
        end
    end
end

function GoalZones:hideAll()
    self._active = nil
    for _, p in pairs(self.zones) do
        p.Color        = ZONE_COLOR_INACTIVE
        p.Transparency = self.visible and ZONE_ALPHA_INACTIVE or 1
    end
end

function GoalZones:setVisible(v)
    self.visible = v
    for _, p in pairs(self.zones) do
        local isActive = (p.Color == ZONE_COLOR_ACTIVE)
        p.Transparency = isActive and (v and ZONE_ALPHA_ACTIVE or 1)
                                  or  (v and ZONE_ALPHA_INACTIVE or 1)
    end
end

function GoalZones:destroy()
    for _, p in pairs(self.zones) do
        if p and p.Parent then p:Destroy() end
    end
    self.zones = {}
end

