local POINTS_COUNT = 101
local MARKERS_COUNT = 15

local visFolder  = nil
local visPoints  = {}
local visBeams   = {}
local visMarkers = {}

local PATH_VIS_ENABLED = false
local PATH_COLOR = Color3.fromRGB(0, 255, 255)

local function createPoint(folder, index)
    local part = Instance.new("Part")
    part.Name = "Point_" .. index
    part.Size = Vector3.new(0.25, 0.25, 0.25)
    part.Transparency = 1
    part.Anchored = true
    part.CanCollide = false
    part.Parent = folder

    local attachment = Instance.new("Attachment")
    attachment.Parent = part

    return { part = part, attachment = attachment }
end

local function buildVisuals()
    if visFolder then return end

    visFolder = Instance.new("Folder")
    visFolder.Name = "BallPredictionVisuals"
    visFolder.Parent = Workspace

    for i = 1, POINTS_COUNT do
        visPoints[i] = createPoint(visFolder, i)
    end

    for i = 1, POINTS_COUNT - 1 do
        local beam = Instance.new("Beam")
        beam.Enabled = false
        beam.Width0 = 0.5
        beam.Width1 = 0.5
        beam.Transparency = NumberSequence.new(0.4)
        beam.Attachment0 = visPoints[i].attachment
        beam.Attachment1 = visPoints[i + 1].attachment
        beam.Parent = visFolder
        visBeams[i] = beam
    end

    for i = 1, MARKERS_COUNT do
        local marker = Instance.new("Part")
        marker.Shape = Enum.PartType.Ball
        marker.Size = Vector3.new(0.45, 0.45, 0.45)
        marker.Material = Enum.Material.Neon
        marker.Anchored = true
        marker.CanCollide = false
        marker.Parent = visFolder
        visMarkers[i] = marker
    end
end

local function clearPathVisuals()
    for _, beam in ipairs(visBeams) do
        beam.Enabled = false
    end
    for _, marker in ipairs(visMarkers) do
        marker.Transparency = 1
    end
end

local function renderPath(pathPoints, bouncePoints)
    if not PATH_VIS_ENABLED then clearPathVisuals(); return end
    if #visPoints == 0 then buildVisuals() end

    local total = #pathPoints
    if total == 0 then clearPathVisuals(); return end

    for i = 1, POINTS_COUNT do
        local rawIdx = ((i - 1) / (POINTS_COUNT - 1)) * (total - 1) + 1
        local idx    = math.max(1, math.min(total, math.floor(rawIdx + 0.5)))
        local pos    = pathPoints[idx]
        if pos then
            visPoints[i].part.Position = pos
        end
    end

    for i = 1, POINTS_COUNT - 1 do
        visBeams[i].Enabled = true
        visBeams[i].Color   = ColorSequence.new(PATH_COLOR)
    end

    for i = 1, MARKERS_COUNT do
        local m  = visMarkers[i]
        local bp = bouncePoints[i]
        if m and bp then
            m.Position     = bp
            m.Transparency = 0.3
        elseif m then
            m.Transparency = 1
        end
    end
end

local function destroyVisuals()
    clearPathVisuals()
    if visFolder and visFolder.Parent then visFolder:Destroy() end
    visFolder  = nil
    visPoints  = {}
    visBeams   = {}
    visMarkers = {}
end

