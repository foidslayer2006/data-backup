end)

local lastModeB     = false
local mainConnection

mainConnection = RunService.RenderStepped:Connect(function(dt)
    local now = tick()

    updateMode(now)

    if modeB_active ~= lastModeB then
        lastModeB = modeB_active
        applyHeightThreshold()
    end

    if modeB_active then
        ModeLabel:SetText(string.format("MODE: B (sound) %.1fs left  | TopY %.1f", modeB_endTime - now, MODE_B_TOP_THRESHOLD))
    else
        ModeLabel:SetText("MODE: A (default)  | TopY: " .. string.format("%.1f", MODE_A_TOP_THRESHOLD))
    end

    if isROnCooldown() then
        RCooldownLabel:SetText(string.format("R Cooldown: %.1fs remaining", rAbilityCooldownEnd - now))
    else
        RCooldownLabel:SetText("R Cooldown: ready ✅")
    end

    if now < goalCooldownEnd then
        StatusLabel:SetText(string.format("⏳ Goal Cooldown: %.1fs", goalCooldownEnd - now))
        clearPathVisuals()
        return
    end

    if tracking and (now - trackingStartTime) >= trackingTimeout then
        resetTracking("⏱ Timed out – cleared")
    end

    local balls    = getValidBalls()
    local didTrack = false

    for _, ballData in ipairs(balls) do
        local model = ballData.model
        local pos   = ballData.position
        local vel   = ballData.velocity

        if tracking and model == currentBallModel then
            local panelNormal = currentPanelCF.LookVector
            local panelOrigin = currentPanelCF.Position
            local dist        = math.abs((pos - panelOrigin):Dot(panelNormal))
            local localPos    = currentPanelCF:PointToObjectSpace(pos)
            local halfW       = leftGoalSize.X / 2
            local halfH       = leftGoalSize.Y / 2
            local inBounds    = math.abs(localPos.X) <= halfW and math.abs(localPos.Y) <= halfH

            local scored = (dist < 2 and inBounds)
                        or (dist > lastKnownDistance and lastKnownDistance < 3)

            if scored then
                local actual = now - startTime
                local diff   = math.abs(predictedTime - actual)
                ActualLabel:SetText(string.format("Actual: %.3fs ✅", actual))
                DiffLabel:SetText(diff <= 0.1
                    and string.format("Difference: %.3fs ✅ GOOD!", diff)
                    or  string.format("Difference: %.3fs ❌ Adjust!", diff))
                resetTracking("⚽ GOAL SCORED!", true)
                goalCooldownEnd = now + 0
                break
            end
            lastKnownDistance = dist
        end

        local ttg, hitPos = predictPanelHit(pos, vel, ballData.modifiers)

        local validA = not modeB_active and ttg and ttg > 0 and ttg < 5
        local validB = modeB_active     and ttg and ttg > 0 and ttg < 3 and vel.Magnitude > 0
        local isCurrentlyTracked = (tracking and model == currentBallModel)

        if validA or validB or isCurrentlyTracked then
            didTrack = true

            if not tracking or currentBallModel ~= model then
                tracking          = true
                currentBallModel  = model
                startTime         = now
                trackingStartTime = now
                missedFrames      = 0
                lastKnownDistance = math.huge
            end

            if ttg and hitPos then
                predictedTime = ttg
                missedFrames  = 0

                if PATH_VIS_ENABLED then
                    local pathPoints, bouncePoints = simulatePath(pos, vel, ballData.modifiers, 5, SIM_STEP)
                    renderPath(pathPoints, bouncePoints)
                else
                    clearPathVisuals()
                end

                local stdHt = modeB_active and MODE_B_TOP_THRESHOLD or MODE_A_TOP_THRESHOLD
                local znStd = getZoneName(hitPos, currentPanelCF, leftGoalSize,
                    ZONE_MID_FRAC, ZONE_MID_SIDE_FRAC, stdHt)
                local _, colForThreshold = splitZone(znStd)

                local effectiveHt = getEffectiveTopThreshold(colForThreshold, ballData.hasIframes)
                local zn = getZoneName(hitPos, currentPanelCF, leftGoalSize,
                    ZONE_MID_FRAC, ZONE_MID_SIDE_FRAC, effectiveHt)

                sharedZones:showFullZone(zn)
                ZoneLabel:SetText(prettyZone(zn))

                if autodiveEnabled and now >= diveCooldownEnd then
                    -- Apply post guard override before diving
                    local effectiveZone, wasRedirected = getPostGuardOverride(zn, ballData.hasIframes)
                    local diveOffset = getDiveOffset(effectiveZone, ballData.hasIframes)

                    if wasRedirected then
                        diveOffset = diveOffset + POST_GUARD_OFFSET_BONUS
                        ZoneLabel:SetText(prettyZone(effectiveZone) .. " ⚠️ POST GUARD")
                    end

                    if ttg <= diveOffset then
                        diveCooldownEnd = now + diveCooldownTime
                        task.spawn(function() performDive(effectiveZone, ballData.hasIframes) end)
                    end
                end

                StatusLabel:SetText("🏐 Tracking → panel")
                PredictedLabel:SetText(string.format("Predicted: %.3fs", predictedTime))
            else
                missedFrames = missedFrames + 1
                if missedFrames > 30 then
                    resetTracking("❌ Lost tracking")
                else
                    StatusLabel:SetText("🏐 Tracking (Stable)")
                end
            end

            ActualLabel:SetText("Actual: --")
            DiffLabel:SetText("Difference: --")
        end
    end

    if not didTrack and not tracking and now >= goalCooldownEnd then
        StatusLabel:SetText(string.format("👀 Watching %d ball(s)...", #balls))
        clearPathVisuals()
    end
end)

local ballCamEnabled  = false
local ballCamSubject  = nil
local originalSubject = nil
local originalMinZoom = nil
local originalMaxZoom = nil
local ballCamZoom     = 70
local camera          = workspace.CurrentCamera
local lp              = Players.LocalPlayer

local ballCamSafetyConnection = nil
local ballCamInputConnection  = nil

local function disableBallCam()
    ballCamEnabled = false
    ballCamSubject = nil
    camera.CameraType = Enum.CameraType.Custom
    if originalMinZoom ~= nil then lp.CameraMinZoomDistance = originalMinZoom; originalMinZoom = nil end
    if originalMaxZoom ~= nil then lp.CameraMaxZoomDistance = originalMaxZoom; originalMaxZoom = nil end
    local char     = lp and lp.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        camera.CameraSubject = humanoid
    elseif originalSubject and originalSubject.Parent then
        camera.CameraSubject = originalSubject
    end
    originalSubject = nil
    StatusLabel:SetText("Ball cam: OFF")
end

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.Backspace then
        if mainConnection          then mainConnection:Disconnect() end
        if ballCamSafetyConnection then ballCamSafetyConnection:Disconnect() end
        if ballCamInputConnection  then ballCamInputConnection:Disconnect() end
        if ballCamEnabled          then disableBallCam() end
        sharedZones:destroy()
        destroyVisuals()
        Library:Unload()
        pcall(function() script:Destroy() end)
    end
end)

local BallCamGroup = Tabs.Settings:AddLeftGroupbox('Ball Cam')
BallCamGroup:AddLabel('Toggle Ball Cam'):AddKeyPicker('BallCamKey', {
    Default='J', SyncToggleState=false, Mode='Dynamic', Text='Toggle Ball Cam', NoUI=false,
})
BallCamGroup:AddSlider('BallCamZoom', {
    Text='Ball Cam Zoom Distance', Min=5, Max=150, Default=70, Rounding=0,
    Callback = function(v)
        ballCamZoom = v
        if ballCamEnabled then
            lp.CameraMinZoomDistance = 0.5
            lp.CameraMaxZoomDistance = v
        end
    end,
})

local function getClientBalls()
    local results = {}
    for _, entity in ipairs(BallFolder:GetChildren()) do
        if isValidBall(entity) then
            local cb = entity:FindFirstChild("ClientBall")
            if cb then table.insert(results, cb) end
        end
    end
    return results
end

local function enableBallCam()
    local balls = getClientBalls()
    if #balls == 0 then
        StatusLabel:SetText("Ball cam: no ClientBall found")
        return
    end
    local candidates = {}
    for _, cb in ipairs(balls) do
        if cb ~= ballCamSubject then table.insert(candidates, cb) end
    end
    if #candidates == 0 then candidates = balls end
    local chosen = candidates[math.random(1, #candidates)]
    ballCamSubject = chosen
    ballCamEnabled = true
    if not originalSubject then originalSubject = camera.CameraSubject end
    originalMinZoom = lp.CameraMinZoomDistance
    originalMaxZoom = lp.CameraMaxZoomDistance
    lp.CameraMinZoomDistance = 0.5
    lp.CameraMaxZoomDistance = ballCamZoom
    camera.CameraSubject = chosen
    camera.CameraType    = Enum.CameraType.Follow
    StatusLabel:SetText("Ball cam: ON")
end

ballCamSafetyConnection = RunService.RenderStepped:Connect(function()
    if ballCamEnabled then
        if not ballCamSubject or not ballCamSubject.Parent then
            disableBallCam()
        end
    end
end)

ballCamInputConnection = UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    local ballCamKey = getPickerKeyCode('BallCamKey', 'End')
    if inp.KeyCode == ballCamKey then
        if ballCamEnabled then disableBallCam() else enableBallCam() end
    end
end)

