local ballIframesState = {}
local ballIframesConns = {}

local function watchBallIframes(model)
    if ballIframesConns[model] then return end
    local serverBall = model:FindFirstChild("ServerBall")
    if not serverBall then return end

    ballIframesState[model] = serverBall:FindFirstChild("IFRAMES") ~= nil

    local addedConn = serverBall.ChildAdded:Connect(function(child)
        if child.Name == "IFRAMES" then ballIframesState[model] = true end
    end)
    local removedConn = serverBall.ChildRemoved:Connect(function(child)
        if child.Name == "IFRAMES" then ballIframesState[model] = false end
    end)
    ballIframesConns[model] = { addedConn, removedConn }
end

local function unwatchBallIframes(model)
    local conns = ballIframesConns[model]
    if conns then
        for _, c in ipairs(conns) do c:Disconnect() end
        ballIframesConns[model] = nil
    end
    ballIframesState[model] = nil
end

local function isValidBall(model)
    if not model:IsA("Model") then return false end
    if model.Name ~= "ballEntity" then return false end
    return model:FindFirstChild("Position")
        and model:FindFirstChild("Velocity")
        and model:FindFirstChild("BallSpeed")
end

local function getModifiers(ball)
    local modifiers = {}
    local part = ball:FindFirstChild("ServerBall")
    if not part then return modifiers end
    local riptide = part:FindFirstChild("RIPTIDE")
    if riptide then
        table.insert(modifiers, {
            Type = "RIPTIDE",
            Direction = riptide.Value,
            EndTime = riptide:GetAttribute("ENDTIME") or 0
        })
    end
    return modifiers
end

for _, model in ipairs(BallFolder:GetChildren()) do
    if isValidBall(model) then watchBallIframes(model) end
end

BallFolder.ChildAdded:Connect(function(model)
    if isValidBall(model) then watchBallIframes(model) end
end)
BallFolder.ChildRemoved:Connect(function(model)
    unwatchBallIframes(model)
end)

local function applyModifiers(velocity, modifiers, time, step)
    for _, mod in ipairs(modifiers) do
        if mod.Type == "RIPTIDE" and time <= mod.EndTime then
            velocity = velocity + mod.Direction * (step * 102)
        end
    end
    return velocity
end

local function getValidBalls()
    local validBalls = {}
    for _, ball in ipairs(BallFolder:GetChildren()) do
        if isValidBall(ball) then
            table.insert(validBalls, {
                model      = ball,
                position   = ball.Position.Value,
                velocity   = ball.Velocity.Value,
                speed      = ball.BallSpeed.Value,
                modifiers  = getModifiers(ball),
                hasIframes = ballIframesState[ball] == true
            })
        end
    end
    return validBalls
end

local function simulatePath(position, velocity, modifiers, duration, step)
    local time = 0
    local points = {position}
    local bounces = 0
    local bouncePoints = {}
    local isRolling = false

    while time < duration do
        velocity = applyModifiers(velocity, modifiers, time, step)
        if isRolling then
            velocity = velocity * ROLLING_FRICTION
            if velocity.Magnitude < STOP_VELOCITY then
                table.insert(points, position)
                break
            end
            position = position + velocity * step
        else
            velocity = velocity + GRAVITY * step
            position = position + velocity * step
        end
        if position.Y < GROUND_Y then
            position = Vector3.new(position.X, GROUND_Y, position.Z)
            bounces = bounces + 1
            if bounces <= MARKERS_COUNT then
                table.insert(bouncePoints, position)
            end
            if math.abs(velocity.Y) * BOUNCE_VEL_Y < MIN_BOUNCE_VELOCITY then
                isRolling = true
                velocity = Vector3.new(velocity.X * BOUNCE_FRICTION, 0, velocity.Z * BOUNCE_FRICTION)
            else
                velocity = Vector3.new(velocity.X * BOUNCE_FRICTION, math.abs(velocity.Y) * BOUNCE_VEL_Y, velocity.Z * BOUNCE_FRICTION)
            end
        end
        table.insert(points, position)
        time = time + step
    end

    return points, bouncePoints
end

local function predictPanelHit(position, velocity, modifiers)
    local time       = 0
    local step       = SIM_STEP
    local maxDuration = 5
    local currentPos = position
    local currentVel = velocity
    local isRolling  = false
    local prevPos    = currentPos

    local panelCF     = currentPanelCF
    local panelNormal = panelCF.LookVector
    local panelOrigin = panelCF.Position
    local halfW       = leftGoalSize.X / 2
    local halfH       = leftGoalSize.Y / 2

    while time < maxDuration do
        currentVel = applyModifiers(currentVel, modifiers, time, step)
        prevPos = currentPos

        if isRolling then
            currentVel = currentVel * ROLLING_FRICTION
            if currentVel.Magnitude < STOP_VELOCITY then break end
            currentPos = currentPos + currentVel * step
        else
            currentVel = currentVel + GRAVITY * step
            currentPos = currentPos + currentVel * step
        end

        if currentPos.Y < GROUND_Y then
            currentPos = Vector3.new(currentPos.X, GROUND_Y, currentPos.Z)
            if math.abs(currentVel.Y) * BOUNCE_VEL_Y < MIN_BOUNCE_VELOCITY then
                isRolling = true
                currentVel = Vector3.new(currentVel.X * BOUNCE_FRICTION, 0, currentVel.Z * BOUNCE_FRICTION)
            else
                currentVel = Vector3.new(currentVel.X * BOUNCE_FRICTION, math.abs(currentVel.Y) * BOUNCE_VEL_Y, currentVel.Z * BOUNCE_FRICTION)
            end
        end

        local dPrev = (prevPos    - panelOrigin):Dot(panelNormal)
        local dCurr = (currentPos - panelOrigin):Dot(panelNormal)

        if dPrev * dCurr <= 0 and dPrev ~= dCurr then
            local t      = dPrev / (dPrev - dCurr)
            local hitPos = prevPos + (currentPos - prevPos) * t

            local localHit = panelCF:PointToObjectSpace(hitPos)
            if math.abs(localHit.X) <= halfW and math.abs(localHit.Y) <= halfH then
                return time + step * t, hitPos
            end
        end

        time = time + step
    end

    return nil, nil
end

