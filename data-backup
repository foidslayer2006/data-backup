local function isModeBSoundPlaying()
    for _, sound in ipairs(trackedSounds) do
        if sound.IsPlaying then return true end
    end
    return false
end

local function updateMode(currentTime)
    if modeB_active then
        if currentTime >= modeB_endTime then
            modeB_active = false
        end
        return
    end
    if currentTime - lastSoundCheck < SOUND_CHECK_INTERVAL then return end
    lastSoundCheck = currentTime
    if isModeBSoundPlaying() then
        modeB_active  = true
        modeB_endTime = currentTime + MODE_B_DURATION
    end
end

