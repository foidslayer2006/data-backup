local MOUSE_BUTTON_MAP = {
    MB1 = Enum.UserInputType.MouseButton1,
    MB2 = Enum.UserInputType.MouseButton2,
    MB3 = Enum.UserInputType.MouseButton3,
}

local function getPickerKeyCode(pickerName, fallback)
    local picker = Options and Options[pickerName]
    local val = picker and picker.Value or fallback
    if typeof(val) == "EnumItem" then return val end
    if type(val) == "string" then
        if MOUSE_BUTTON_MAP[val] then return MOUSE_BUTTON_MAP[val] end
        local ok, kc = pcall(function() return Enum.KeyCode[val] end)
        if ok and kc then return kc end
    end
    if fallback then
        if MOUSE_BUTTON_MAP[fallback] then return MOUSE_BUTTON_MAP[fallback] end
        local ok, kc = pcall(function() return Enum.KeyCode[fallback] end)
        if ok then return kc end
    end
    return nil
end

local function pressEnum(kc)
    if not kc then return end
    pcall(function()
        if typeof(kc) == "EnumItem" and kc.EnumType == Enum.UserInputType then
            local buttonIndex
            if kc == Enum.UserInputType.MouseButton1 then
                buttonIndex = 0
            elseif kc == Enum.UserInputType.MouseButton2 then
                buttonIndex = 1
            elseif kc == Enum.UserInputType.MouseButton3 then
                buttonIndex = 2
            else
                return
            end
            if kc == Enum.UserInputType.MouseButton2 and mb2HeldByUser then
                VirtualInputManager:SendMouseButtonEvent(0, 0, buttonIndex, false, game, 0)
                mb2HeldByUser = false
            else
                VirtualInputManager:SendMouseButtonEvent(0, 0, buttonIndex, true, game, 0)
                RunService.RenderStepped:Wait()
                VirtualInputManager:SendMouseButtonEvent(0, 0, buttonIndex, false, game, 0)
            end
        else
            if kc == Enum.KeyCode.R then startRCooldown() end
            VirtualInputManager:SendKeyEvent(true, kc, false, game)
            RunService.RenderStepped:Wait()
            VirtualInputManager:SendKeyEvent(false, kc, false, game)
        end
    end)
end

local function resolveMidKey(hasIframes, row)
    if hasIframes then
        local key = row == "TOP" and 'DiveMidTopIframesKey' or 'DiveMidBotIframesKey'
        return getPickerKeyCode(key, 'R')
    end
    if isROnCooldown() then
        return Enum.UserInputType.MouseButton2
    end
    if math.random(2) == 1 then
        local key = row == "TOP" and 'DiveMidTopKey' or 'DiveMidBotKey'
        return getPickerKeyCode(key, 'R')
    else
        return Enum.UserInputType.MouseButton2
    end
end

local function performDive(zoneName, hasIframes)
    if not zoneName then return end

    local row, col = splitZone(zoneName)
    local doJump   = (row == "TOP")

    local leftKey  = getPickerKeyCode('DiveLeftKey',  'C')
    local rightKey = getPickerKeyCode('DiveRightKey', 'Z')
    local jumpKey  = getPickerKeyCode('DiveJumpKey',  'Space')

    local midKey
    if col == "MIDDLE" then
        midKey = resolveMidKey(hasIframes, row)
    end

    local directionKey
    if m2OnlyMode then
        directionKey = Enum.UserInputType.MouseButton2
    elseif acroMode then
        directionKey = getPickerKeyCode('DiveMidTopKey', 'R')
    else
        if col == "LEFT" or col == "MID_LEFT" then
            directionKey = leftKey
        elseif col == "RIGHT" or col == "MID_RIGHT" then
            directionKey = rightKey
        else
            directionKey = midKey
        end
    end

    if doJump then
        pressEnum(jumpKey)
        local jumpDelay
        if m2OnlyMode then
            jumpDelay = m2JumpDelay
        elseif acroMode then
            jumpDelay = acroJumpDelay
        else
            jumpDelay = modeB_active and modeBJumpDelay or modeAJumpDelay
        end
        task.wait(jumpDelay)
    end

    local isLeftRight = (directionKey == leftKey or directionKey == rightKey)
    if isLeftRight then
        task.spawn(function() pressEnum(Enum.UserInputType.MouseButton1) end)
    end
    pressEnum(directionKey)

    diveCooldownEnd = tick() + diveCooldownTime
end

